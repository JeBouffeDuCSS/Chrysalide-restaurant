# =============================================================
# Chrysalide — variables d'environnement
# Copier ce fichier en .env (ne pas le committer)
# =============================================================

# Destinataire principal des emails de réservation
MAIL_TO=chrysalidelyon@outlook.fr

# Adresse d'expédition (doit être autorisée par le fournisseur SMTP)
MAIL_FROM=no-reply@chrysalide-lyon.fr

# CC technique (facultatif) pour audit/debug
MAIL_CC=

# SMTP via Nodemailer (compte transactionnel : Resend, SendGrid, Postmark, OVH...)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Alternative : clé API d'un service transactionnel
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# POSTMARK_TOKEN=

# Rate limiting (soumissions / IP / heure)
FORM_RATE_LIMIT=3
